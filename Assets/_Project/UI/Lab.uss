.lab-field {
    margin: 1px 0;
}

.lab-field .unity-base-field__input {
    font-size: 13px;
}

.lab-field > .unity-base-field__label {
    min-width: 64px;
    width: 64px;
    color: rgb(140, 178, 164);
    font-size: 13px;
}

.lab-row {
    flex-direction: row;
    margin-top: 4px;
}

.lab-button {
    margin: 0 4px 0 0;
    padding: 2px 8px;
    font-size: 13px;
}

.lab-button--primary {
    -unity-font-style: bold;
}

.lab-button--active {
    background-color: rgb(25, 158, 112);
    color: rgb(255, 255, 255);
}

.workspace { flex-grow: 1; color: rgb(222, 234, 230); padding: 0; }
.workspace .unity-base-field__input { background-color: rgb(26, 46, 53); color: rgb(230, 239, 234); min-height: 28px; border-radius: 3px; }
.workspace .unity-base-field__label { color: rgb(165, 191, 184); }
.workspace .unity-text-element--inner-input-field { color: rgb(230, 239, 234); }
.toolbar { flex-direction: row; align-items: center; background-color: rgb(10, 22, 27); padding: 7px 12px; min-height: 52px; flex-shrink: 0; }
.brand { font-size: 22px; -unity-font-style: bold; letter-spacing: 4px; margin-right: 14px; }
.session-state { flex-grow: 1; margin-left: 8px; font-size: 13px; color: rgb(115, 218, 175); }
.lab-button { min-height: 30px; padding: 4px 9px; border-radius: 4px; background-color: rgb(30, 48, 55); color: rgb(225, 237, 232); }
.lab-button:hover { background-color: rgb(45, 75, 80); }
.lab-button:focus { border-color: rgb(110, 220, 180); border-width: 1px; }
.lab-button--primary { background-color: rgb(24, 107, 80); }
.workspace .lab-button--active { background-color: rgb(25, 120, 90); color: rgb(255, 255, 255); border-bottom-color: rgb(110, 220, 180); border-bottom-width: 2px; }
.lab-field { margin-bottom: 9px; min-height: 30px; }
.lab-field > .unity-base-field__label { min-width: 160px; width: 160px; font-size: 14px; white-space: normal; }
.screen { flex-grow: 1; padding: 20px 28px; background-color: rgb(15, 29, 35); }
.home-screen { justify-content: center; padding-left: 12%; }
.hero-title { font-size: 34px; -unity-font-style: bold; margin-bottom: 12px; }
.page-title { font-size: 25px; -unity-font-style: bold; margin-bottom: 14px; }
.section-title { font-size: 17px; -unity-font-style: bold; flex-grow: 1; white-space: normal; }
.muted { color: rgb(155, 184, 178); font-size: 13px; white-space: normal; margin: 4px 0; }
.home-action { max-width: 360px; min-height: 48px; font-size: 17px; margin-top: 12px; }
.tab-row { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; padding: 4px 0; }
.config-body { flex-direction: row; flex-grow: 1; min-height: 0; margin-top: 12px; }
.config-form { flex-grow: 1; flex-basis: 55%; min-width: 320px; padding-right: 18px; }
.config-page { flex-grow: 1; }
.config-footer { flex-direction: row; align-items: center; padding-top: 12px; flex-shrink: 0; }
.preview-panel { flex-grow: 1; flex-basis: 45%; min-width: 230px; padding: 14px; background-color: rgb(10, 23, 29); border-radius: 7px; }
.preview-host { flex-grow: 1; min-height: 160px; }
.review-summary { font-size: 15px; white-space: normal; color: rgb(215, 231, 222); margin: 8px; }
.message { font-size: 14px; white-space: normal; color: rgb(245, 198, 117); background-color: rgb(22, 33, 37); padding: 4px 12px; }
.simulation-screen { flex-grow: 1; min-height: 0; }
.indicators { flex-direction: row; background-color: rgb(15, 29, 35); padding: 3px 12px; flex-shrink: 0; }
.indicator { flex-grow: 1; margin-right: 16px; }
.indicator-value { font-size: 20px; -unity-font-style: bold; }
.simulation-main { flex-direction: row; flex-grow: 1; min-height: 80px; }
.simulation-screen > .tab-row { background-color: rgb(15, 29, 35); padding-left: 10px; }
.arena-viewport { flex-grow: 1; min-width: 100px; }
.arena-caption { position: absolute; bottom: 8px; left: 12px; color: rgb(150, 180, 174); font-size: 12px; }
.workspace-side { width: 340px; min-width: 250px; max-width: 650px; background-color: rgb(12, 25, 31); padding: 10px; }
.workspace-side > ScrollView { flex-grow: 1; }
.side-divider { width: 5px; background-color: rgb(40, 65, 68); }
.chart-divider { height: 5px; background-color: rgb(40, 65, 68); }
.analysis-panel { height: 330px; min-height: 170px; background-color: rgb(12, 25, 31); padding: 0 12px 8px; flex-shrink: 0; }
.chart-data-table { height: 100px; min-height: 80px; }
.library-body { flex-direction: row; flex-grow: 1; min-height: 100px; }
.library-list { flex-grow: 1; min-height: 100px; flex-basis: 50%; }
.library-details { flex-grow: 1; flex-basis: 50%; padding: 12px; background-color: rgb(10, 23, 29); }
.library-list .unity-list-view__item { padding: 6px 8px; font-size: 14px; }
.search-field { flex-grow: 1; margin-right: 10px; min-width: 220px; }
.workspace-footer { flex-direction: row; flex-shrink: 0; min-height: 25px; background-color: rgb(10, 22, 27); padding: 2px 12px; }
.workspace-footer > Label { flex-grow: 1; }
.workspace-footer > #checkpoint-status { max-width: 68%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workspace-footer > #help { font-size: 12px; }
.inspector-content { flex-grow: 1; min-height: 80px; }
.inspector-content > ScrollView { flex-grow: 1; padding: 5px; }
.modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.75); justify-content: center; align-items: center; }
.modal-box { width: 440px; padding: 28px; background-color: rgb(18, 40, 45); border-radius: 10px; }
.modal-box > Button { margin-top: 12px; }
