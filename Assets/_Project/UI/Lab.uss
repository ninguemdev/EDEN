.lab-field {
    margin: 1px 0;
}

.lab-field .unity-base-field__input {
    font-size: 13px;
}

.lab-field > .unity-base-field__label {
    min-width: 64px;
    width: 64px;
    color: rgb(140, 178, 164);
    font-size: 13px;
}

.lab-row {
    flex-direction: row;
    margin-top: 4px;
}

.lab-button {
    margin: 0 4px 0 0;
    padding: 2px 8px;
    font-size: 13px;
}

.lab-button--primary {
    -unity-font-style: bold;
}

.lab-button--active {
    background-color: rgb(25, 158, 112);
    color: rgb(255, 255, 255);
}
