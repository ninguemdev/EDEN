<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Lab.uss" />
    <ui:VisualElement name="bootstrap-root" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row; justify-content: space-between; align-items: flex-start; padding: 16px;">
        <ui:VisualElement name="run-panel" picking-mode="Ignore" class="lab-panel" style="width: 400px; max-height: 100%; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; background-color: rgba(8, 16, 20, 0.82); overflow: hidden;">
            <ui:ScrollView name="run-panel-scroll" mode="Vertical" style="flex-grow: 1; height: 100%; padding: 12px 14px;">
                <ui:Label name="title" text="EDEN" style="font-size: 34px; -unity-font-style: bold; color: rgb(226, 240, 233); letter-spacing: 10px;" />
                <ui:Label name="subtitle" text="Evolutionary Digital Ecosystem Network" style="font-size: 13px; color: rgb(140, 178, 164); margin-bottom: 6px;" />
                <ui:VisualElement name="experiment-panel" class="lab-controls">
                    <ui:DropdownField name="mode-field" label="Modo" class="lab-field" />
                    <ui:DropdownField name="preset-field" label="Preset" class="lab-field" />
                    <ui:DropdownField name="brain-field" label="Cérebro" class="lab-field" />
                    <ui:VisualElement name="composition-panel" style="display: none;">
                        <ui:TextField name="composition-field" label="Composição (arquivo*N; #k*N)" class="lab-field" />
                        <ui:DropdownField name="composition-mode-field" label="Genomas" class="lab-field" />
                    </ui:VisualElement>
                    <ui:DropdownField name="body-field" label="Corpo" class="lab-field" />
                    <ui:DropdownField name="algorithm-field" label="Algoritmo" class="lab-field" />
                    <ui:DropdownField name="senses-field" label="Sentidos" class="lab-field" />
                    <ui:DropdownField name="arena-field" label="Arena" class="lab-field" />
                    <ui:Foldout name="scenario-foldout" text="Cenário: tamanho e recursos" value="false" class="lab-field">
                        <ui:DropdownField name="scenario-size-field" label="Tamanho" class="lab-field" />
                        <ui:DropdownField name="scenario-resources-field" label="Recursos" class="lab-field" />
                        <ui:IntegerField name="scenario-food-field" label="Comida no 50×50 (0 = do modo)" value="0" class="lab-field" />
                        <ui:FloatField name="scenario-food-energy-field" label="Energia por comida" class="lab-field" />
                        <ui:FloatField name="scenario-food-respawn-field" label="Comida volta em (s)" class="lab-field" />
                        <ui:DropdownField name="scenario-water-field" label="Água (implica sólidos)" class="lab-field" />
                        <ui:DropdownField name="scenario-water-supply-field" label="Oferta de água" class="lab-field" />
                        <ui:FloatField name="scenario-water-capacity-field" label="Reserva por lago (50×50)" class="lab-field" />
                        <ui:FloatField name="scenario-water-recharge-field" label="Recarga por lago/s (50×50)" class="lab-field" />
                        <ui:FloatField name="scenario-episode-field" label="Episódio (s)" class="lab-field" />
                        <ui:FloatField name="scenario-max-age-field" label="Idade máxima (s)" class="lab-field" />
                        <ui:FloatField name="scenario-initial-energy-field" label="Energia inicial" class="lab-field" />
                    </ui:Foldout>
                    <ui:DropdownField name="training-field" label="Treino" class="lab-field" tooltip="Paralelo usa a CPU para avaliar mundos independentes. Use Máx. para acelerar o treino; a arena mostra um dos episódios." />
                    <ui:Foldout name="observation-foldout" text="Gravação e acompanhamento" value="false" class="lab-field">
                        <ui:IntegerField name="auto-checkpoint-field" label="Checkpoint a cada gerações (0 desliga)" value="50" class="lab-field" />
                        <ui:DropdownField name="follow-field" label="Acompanhar" class="lab-field" />
                        <ui:IntegerField name="follow-top-field" label="Melhores N" value="5" class="lab-field" />
                        <ui:IntegerField name="follow-rank-field" label="Posição inicial" value="1" class="lab-field" />
                        <ui:FloatField name="replay-speed-field" label="Velocidade do replay" value="1" class="lab-field" />
                        <ui:Button name="follow-refresh-button" text="Atualizar ranking agora" class="lab-button" />
                        <ui:Label text="Replays independentes do treino. O ranking atualiza a cada ciclo ou pelo botão." style="white-space: normal; font-size: 11px;" />
                    </ui:Foldout>
                    <ui:DropdownField name="profile-field" label="Perfil" class="lab-field" tooltip="Como cada genoma é pontuado. Somente busca ou duas etapas com híbrida e fome/sede; o perfil antigo mantém busca sem gasto." />
                    <ui:Foldout name="profile-foldout" text="Busca — configuração" value="false" class="lab-field">
                        <ui:FloatField name="profile-weight-field" label="Peso da busca (%)" class="lab-field" />
                        <ui:FloatField name="profile-seconds-field" label="Duração da busca (s)" class="lab-field" />
                        <ui:IntegerField name="profile-food-field" label="Alvos de comida" class="lab-field" />
                        <ui:IntegerField name="profile-water-field" label="Alvos de água" class="lab-field" />
                        <ui:FloatField name="profile-distance-field" label="Distância mínima" class="lab-field" />
                        <ui:FloatField name="profile-alpha-field" label="Crédito de aproximação (α)" class="lab-field" />
                        <ui:FloatField name="profile-beta-field" label="Parte da rapidez (β)" class="lab-field" />
                        <ui:DropdownField name="profile-obstacles-field" label="Obstáculos da busca" class="lab-field" />
                    </ui:Foldout>
                    <ui:IntegerField name="seed-field" label="Seed" value="1" class="lab-field" />
                    <ui:VisualElement class="lab-row">
                        <ui:TextField name="seed-genomes-field" label="Pool de genomas" class="lab-field" style="flex-grow: 1;" />
                        <ui:Button name="use-export-directory-button" text="Usar exportação" class="lab-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab-row">
                        <ui:Button name="start-button" text="Iniciar" class="lab-button lab-button--primary" />
                        <ui:Button name="resume-evolution-button" text="Voltar à evolução" class="lab-button" style="display: none;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab-row">
                        <ui:Button name="pause-button" text="Pausar" class="lab-button" />
                        <ui:Button name="step-button" text="+1 tick" class="lab-button" />
                        <ui:Button name="slower-button" text="½×" class="lab-button" />
                        <ui:Button name="faster-button" text="2×" class="lab-button" />
                        <ui:Button name="max-button" text="Máx." class="lab-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab-row">
                        <ui:Button name="save-button" text="Salvar" class="lab-button" />
                        <ui:Button name="load-button" text="Carregar" class="lab-button" />
                    </ui:VisualElement>
                    <ui:Label name="checkpoint-status" text="" style="display: none; font-size: 12px; color: rgb(160, 190, 180); white-space: normal; margin-top: 2px;" />
                </ui:VisualElement>
                <ui:Label name="run-stats" text="" style="font-size: 14px; color: rgb(214, 226, 220); white-space: normal; margin-top: 8px;" />
                <ui:VisualElement name="chart-panel" picking-mode="Ignore" style="display: none; margin-top: 8px;">
                    <ui:Label name="chart-title" text="Fitness por geração (comida ingerida / s simulado)" style="font-size: 13px; -unity-font-style: bold; color: rgb(226, 240, 233);" />
                    <ui:Label name="chart-legend" text="" style="font-size: 11px; color: rgb(160, 190, 180); white-space: normal; margin-bottom: 2px;" />
                    <ui:VisualElement name="generation-chart-host" picking-mode="Ignore" style="height: 280px;" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="inspector-panel" picking-mode="Ignore" style="display: none; width: 420px; max-height: 100%; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; background-color: rgba(8, 16, 20, 0.82); overflow: hidden;">
            <ui:ScrollView name="inspector-panel-scroll" mode="Vertical" style="flex-grow: 1; height: 100%; padding: 14px;">
                <ui:Label name="inspector" text="" style="font-size: 15px; color: rgb(214, 226, 220); white-space: normal;" />
                <ui:VisualElement name="export-genome-row" class="lab-row" style="display: none; margin-top: 8px;">
                    <ui:Button name="export-genome-button" text="Exportar genoma" class="lab-button" />
                    <ui:Button name="copy-genome-directory-button" text="Copiar pasta" class="lab-button" />
                </ui:VisualElement>
                <ui:Label name="export-status" text="" style="display: none; font-size: 12px; color: rgb(160, 190, 180); white-space: normal; margin-top: 4px;" />
                <ui:VisualElement name="network-panel" picking-mode="Ignore" style="display: none; margin-top: 10px;">
                    <ui:Label name="network-title" text="Rede neural (feed-forward: sem memória nem aprendizado)" style="font-size: 14px; -unity-font-style: bold; color: rgb(226, 240, 233); white-space: normal;" />
                    <ui:Label name="network-legend" text="Neurônios: ativação (verde +, vermelho −). Linhas: peso × sinal." style="font-size: 12px; color: rgb(140, 178, 164); white-space: normal; margin-bottom: 4px;" />
                    <ui:VisualElement name="network-graph-host" picking-mode="Ignore" style="height: 340px;" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label name="help" picking-mode="Ignore" text="Espaço pausar · . um tick · - / = velocidade · M máx. · clique ou [ ] selecionar · Esc limpar · R reiniciar · B trocar cérebro · F5 salvar · F9 carregar" style="position: absolute; left: 16px; bottom: 12px; font-size: 14px; color: rgb(140, 178, 164);" />
</ui:UXML>
